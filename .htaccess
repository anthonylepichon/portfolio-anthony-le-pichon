# ============================================================
# REDIRECTIONS ET URL CANONIQUE
# ============================================================

# Active les règles de réécriture.
RewriteEngine On


# ------------------------------------------------------------
# 1. Redirige /index.html vers la racine /
# ------------------------------------------------------------
# Évite que Google considère :
# https://anthonylepichon.com/
# et
# https://anthonylepichon.com/index.html
# comme deux pages différentes.

RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://anthonylepichon.com/ [R=301,L]


# ------------------------------------------------------------
# 2. Force HTTPS et supprime www
# ------------------------------------------------------------
# Toutes les variantes :
#
# http://anthonylepichon.com
# http://www.anthonylepichon.com
# https://www.anthonylepichon.com
#
# sont redirigées vers :
#
# https://anthonylepichon.com

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.anthonylepichon\.com$ [NC]
RewriteRule ^ https://anthonylepichon.com%{REQUEST_URI} [R=301,L]


# ============================================================
# EN-TÊTES DE SÉCURITÉ
# ============================================================

<IfModule mod_headers.c>

    # HSTS demande au navigateur de privilégier HTTPS
    # lors des prochaines visites.
    Header always set Strict-Transport-Security "max-age=31536000"

    # Empêche le navigateur d'interpréter un fichier avec
    # un autre type MIME que celui annoncé par le serveur.
    Header always set X-Content-Type-Options "nosniff"

    # Empêche l'affichage du portfolio dans un iframe
    # provenant d'un autre site.
    Header always set X-Frame-Options "DENY"

    # Limite les informations transmises dans l'en-tête Referer.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Désactive les fonctionnalités du navigateur
    # qui ne sont pas utilisées par le portfolio.
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"

    # Content Security Policy.
    # Formspree est autorisé pour le formulaire de contact.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self' https://formspree.io; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; font-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; upgrade-insecure-requests"

</IfModule>
