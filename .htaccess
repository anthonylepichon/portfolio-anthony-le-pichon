# Active les règles de réécriture afin de pouvoir rediriger les visiteurs.
RewriteEngine On

# Le site doit toujours être consulté en HTTPS. La redirection 301 indique aux
# navigateurs et aux moteurs de recherche que cette adresse est définitive.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://anthonylepichon.com%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
    # HSTS demande au navigateur de privilégier HTTPS lors des prochaines visites.
    # Il est envoyé par le serveur, même si un visiteur a initialement saisi HTTP.
    Header always set Strict-Transport-Security "max-age=31536000"

    # Empêche le navigateur d'interpréter un fichier avec un autre type que celui
    # annoncé par le serveur et réduit quelques risques d'injection de contenu.
    Header always set X-Content-Type-Options "nosniff"

    # Empêche l'affichage du portfolio dans un iframe d'un autre site.
    Header always set X-Frame-Options "DENY"

    # Limite les informations transmises dans l'en-tête Referer lors d'un lien externe.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Désactive des fonctionnalités du navigateur qui ne sont pas utilisées par le portfolio.
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"

    # La politique CSP autorise uniquement les fichiers du portfolio. Formspree est
    # ajouté explicitement car il reçoit les envois du formulaire de contact.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self' https://formspree.io; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; font-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; upgrade-insecure-requests"
</IfModule>
